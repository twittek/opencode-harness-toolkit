{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.local/schemas/policy-registry.schema.json",
  "title": "OpenCode Harness Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "registryVersion", "subject", "enforcementMode", "signals", "thresholds", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "registryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "registryVersion": { "type": "integer", "minimum": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "enforcementMode": { "enum": ["observe", "advise", "enforce"] },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signal" }
    },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "source", "requiredProvenance", "maxAgeSeconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]+$" },
        "type": { "enum": ["boolean", "number", "integer", "string", "string-array"] },
        "source": { "enum": ["observer", "decision-model", "static-policy"] },
        "requiredProvenance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxAgeSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "description": { "type": "string" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnAt", "escalateAt", "blockAt", "minimumCoverage"],
      "properties": {
        "warnAt": { "type": "number", "minimum": 0, "maximum": 1 },
        "escalateAt": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockAt": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumCoverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "reasonCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail", "unknown"],
      "properties": {
        "fail": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "unknown": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "rationale", "severity", "weight", "hardGate", "appliesWhen", "assertion", "requiredSignals", "onUnknown", "reasonCodes", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "hardGate": { "type": "boolean" },
        "appliesWhen": { "$ref": "#/$defs/predicate" },
        "assertion": { "$ref": "#/$defs/predicate" },
        "requiredSignals": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "onUnknown": { "enum": ["record", "escalate", "block"] },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": { "enum": ["all", "any"] },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {
            "op": { "const": "not" },
            "arg": { "$ref": "#/$defs/predicate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "fact"],
          "properties": {
            "op": { "const": "exists" },
            "fact": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "fact", "value"],
          "properties": {
            "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "matches"] },
            "fact": { "type": "string" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "fact", "values"],
          "properties": {
            "op": { "enum": ["in", "not_in"] },
            "fact": { "type": "string" },
            "values": { "type": "array", "minItems": 1 }
          }
        }
      ]
    }
  }
}

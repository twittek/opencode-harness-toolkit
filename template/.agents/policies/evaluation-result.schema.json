{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.local/schemas/evaluation-result.schema.json",
  "title": "OpenCode Harness Policy Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryId", "registryVersion", "enforcementMode", "taskId", "evaluatedAt", "complianceScore", "violationScore", "coverage", "recommendedAction", "rules"],
  "properties": {
    "registryId": { "type": "string" },
    "registryVersion": { "type": "integer" },
    "enforcementMode": { "enum": ["observe", "advise", "enforce"] },
    "taskId": { "type": "string" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "complianceScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "violationScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommendedAction": { "enum": ["continue", "warn", "escalate", "block"] },
    "reasonCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "ruleVersion", "status", "result", "violationValue", "reasonCode", "evidenceRefs"],
        "properties": {
          "ruleId": { "type": "string" },
          "ruleVersion": { "type": "integer" },
          "status": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE", "ERROR"] },
          "result": { "type": ["boolean", "null"] },
          "violationValue": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "reasonCode": { "type": ["string", "null"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}

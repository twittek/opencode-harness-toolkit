{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.local/schemas/tektona-deployment.schema.json",
  "title": "OpenCode Harness Tektona Deployment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "subject", "scope", "organization", "project", "template", "build", "sandbox", "integrations", "deployment"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "platform": { "const": "tektona" },
    "subject": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["project", "organization"] },
    "organization": { "type": "string", "minLength": 1 },
    "project": { "type": ["string", "null"], "minLength": 1 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference", "displayName", "description", "tag", "lifecyclePolicy"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$" },
        "reference": { "type": "string", "pattern": "^(project|org)/[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^(project|org)/[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "lifecyclePolicy": { "enum": ["inherited", "project", "organization"] }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "strategy", "manifest", "dockerfile", "context", "imagePlan", "baseImage", "resultImageRef", "resultImageVisibility", "asynchronous", "waitForCompletion", "tagOnSuccess", "localValidationOptional"],
      "properties": {
        "provider": { "const": "tektona-template-build" },
        "strategy": { "enum": ["native-manifest", "external-oci-image"] },
        "manifest": { "const": ".agents/runtime/sandbox.template.tektona.yaml" },
        "dockerfile": { "const": "Dockerfile" },
        "context": { "const": "." },
        "imagePlan": { "const": ".agents/runtime/image-plan.json" },
        "baseImage": { "type": "string", "minLength": 1 },
        "resultImageRef": { "type": ["string", "null"], "minLength": 1 },
        "resultImageVisibility": { "enum": ["not-applicable", "public", "private"] },
        "asynchronous": { "const": true },
        "waitForCompletion": { "type": "boolean" },
        "tagOnSuccess": { "const": true },
        "localValidationOptional": { "const": true }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createAfterBuild", "name", "repositoryRef", "resources", "lifecycle", "processes"],
      "properties": {
        "createAfterBuild": { "type": "boolean" },
        "name": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$" },
        "repositoryRef": { "type": ["string", "null"], "minLength": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memoryMiB", "diskGiB", "location"],
          "properties": {
            "cpu": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "memoryMiB": { "type": ["integer", "null"], "minimum": 256 },
            "diskGiB": { "type": ["integer", "null"], "minimum": 1 },
            "location": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["autoPauseMinutes", "autoDeleteHours"],
          "properties": {
            "autoPauseMinutes": { "type": ["integer", "null"], "minimum": 0 },
            "autoDeleteHours": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "processes": {
          "type": "array",
          "items": { "$ref": "#/$defs/process" }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCredentialRef", "containerRegistryRef", "egressNetworkPolicyRef", "egressProxyProfileRef", "secretRefs"],
      "properties": {
        "gitCredentialRef": { "type": ["string", "null"], "minLength": 1 },
        "containerRegistryRef": { "type": ["string", "null"], "minLength": 1 },
        "egressNetworkPolicyRef": { "type": ["string", "null"], "minLength": 1 },
        "egressProxyProfileRef": { "type": ["string", "null"], "minLength": 1 },
        "secretRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "approved", "adapter", "adapterPath", "verifiedAgainst", "interfaceEvidenceRefs"],
      "properties": {
        "mode": { "enum": ["plan", "build-template", "build-and-create-sandbox"] },
        "approved": { "type": "boolean" },
        "adapter": { "enum": ["unresolved", "cli", "sdk", "api"] },
        "adapterPath": { "type": ["string", "null"], "minLength": 1 },
        "verifiedAgainst": { "type": ["string", "null"], "minLength": 1 },
        "interfaceEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "workingDirectory", "autostart", "waitForPort"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "workingDirectory": { "const": "repository-root" },
        "autostart": { "type": "boolean" },
        "waitForPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
